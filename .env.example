# Local development
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio
JWT_SECRET=replace-with-at-least-32-characters
ADMIN_EMAIL=admin@example.com

# In development, this can be a plain-text password.
# In production, use a pbkdf2 hash in this format:
# pbkdf2$210000$<hex-salt>$<hex-hash>
ADMIN_PASSWORD_HASH=admin-password

# EmailJS (client-side, baked into bundle at `pnpm build` time).
# Public key is intended to be public; restrict abuse via EmailJS
# dashboard "Allowed Origins" instead of trying to hide it.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Railway production values
# NODE_ENV=production
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# JWT_SECRET=<32+ character secret>
# ADMIN_EMAIL=<admin email>
# ADMIN_PASSWORD_HASH=<pbkdf2 hash>
# VITE_EMAILJS_SERVICE_ID=<from EmailJS dashboard>
# VITE_EMAILJS_TEMPLATE_ID=<from EmailJS dashboard>
# VITE_EMAILJS_PUBLIC_KEY=<from EmailJS dashboard>
